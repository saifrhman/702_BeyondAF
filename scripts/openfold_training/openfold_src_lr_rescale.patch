--- a/openfold/utils/lr_schedulers.py
+++ b/openfold/utils/lr_schedulers.py
@@ -58,8 +58,25 @@
 
         return state_dict
 
+    # Position is restored from the checkpoint; configuration is not.
+    #
+    # state_dict() above persists *every* attribute except the optimizer, so the
+    # schedule's shape -- max_lr, the decay points, the factor -- travels inside
+    # the checkpoint. The plain dict update this used to do therefore let a
+    # checkpoint silently overwrite a schedule set in code: change the values,
+    # resume, and the old ones win, with nothing in any log to say the change had
+    # not applied. That is the worst kind of bug, because the run looks fine.
+    #
+    # What has to survive a resume is where the optimizer had got to. The shape
+    # of the schedule is a decision, and decisions belong in code that can be
+    # read and reviewed, not baked into a 1.5 GB binary. So restore the counters
+    # and let the constructor supply the rest.
+    _POSITION_KEYS = ("last_epoch", "_step_count", "_last_lr", "base_lrs")
+
     def load_state_dict(self, state_dict):
-        self.__dict__.update(state_dict)
+        self.__dict__.update({
+            k: v for k, v in state_dict.items() if k in self._POSITION_KEYS
+        })
 
     def get_lr(self):
         if(not self._get_lr_called_within_step):
